# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the app (used for origin checks and auth callbacks)
# Optional on Vercel (defaults to the deployment URL). Locally:
APP_URL=http://localhost:3000

# --- F1 Sign-in ---
# MongoDB Atlas connection string, with the database name at the end: ...mongodb.net/clipguru
MONGODB_URI=
# Random 32+ character secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google OAuth client (Google Cloud Console > Credentials). Leave empty to hide Google sign-in.
# Authorised redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Resend key. When set, verification and reset emails are sent and email
# verification is required. When empty, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="ClipGuru <onboarding@resend.dev>"
# Optional: "memory" runs auth on an in-process store (local tests without Atlas).
# DB_DRIVER=memory
